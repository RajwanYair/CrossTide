{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.biome": "explicit"
  },
  "editor.quickSuggestions": {
    "strings": true,
    "comments": true,
    "other": true
  },
  "editor.wordWrap": "on",
  "editor.minimap.enabled": true,
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "smooth",
  "editor.linkedEditing": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "workbench.startupEditor": "readme",
  "explorer.autoReveal": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.fetchOnPull": true,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enablePersistentSessions": true,
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/.wrangler": true,
    "**/.astro": true,
    "**/package-lock.json": true,
    "**/.git": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/build": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/.wrangler": true,
    "**/.astro": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/build/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/.wrangler/**": true,
    "**/.astro/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.maxTsServerMemory": 6144,
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.disableAutomaticTypeAcquisition": true,
  "javascript.preferences.includePackageJsonAutoImports": "off",
  "npm.packageManager": "npm",
  "npm.autoDetect": "on",
  "eslint.useFlatConfig": true,
  "css.validate": false,
  "css.customData": ["./config/css-custom-data.json"],
  "stylelint.validate": ["css"],
  "stylelint.configFile": "./config/.stylelintrc.json",
  "html.validate.scripts": true,
  "html.validate.styles": true,
  "html.format.wrapLineLength": 120,
  "html.customData": ["./config/html-custom-data.json"],
  "markdownlint.config": {
    "extends": "./config/.markdownlint.json"
  },
  "coverage-gutters.coverageBaseDir": "coverage",
  "coverage-gutters.coverageFileNames": ["lcov.info"],
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": false,
    "scminput": true,
    "yaml": true
  },
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.codesearch.enabled": true,
  "chat.instructionsFilesLocations": {
    ".github/copilot-instructions.md": true,
    ".github/instructions": true
  },
  "chat.promptFilesLocations": {
    ".github/prompts": true
  },
  "chat.modeFilesLocations": {
    ".github/agents": true
  },
  "chat.todoListTool.enabled": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits: type(scope): lowercase subject, no trailing period, max 72 chars. Types: feat fix docs refactor test chore perf ci. Scopes: domain worker cards core ui ci docs screener portfolio alerts consensus watchlist chart."
    }
  ],
  "github.copilot.chat.reviewSelection.instructions": [
    {
      "file": ".github/copilot-instructions.md"
    }
  ],
  "github.copilot.chat.testGeneration.instructions": [
    {
      "file": ".github/instructions/tests.instructions.md"
    }
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    {
      "text": "Summarize what changed and why, grouped by layer (domain/worker/cards/core/ui/ci). Call out quality-gate impact: coverage thresholds, bundle size, or new tests. Keep it factual and short; no marketing language."
    }
  ],
  "browser-compatibility-checker.browserList": [
    "chrome",
    "edge",
    "firefox",
    "opera",
    "safari",
    "chrome_android",
    "firefox_android",
    "opera_android",
    "safari_ios",
    "samsunginternet_android",
    "webview_android"
  ],
  "browser-compatibility-checker.warnForOtherBrowsers": false,
  "browser-compatibility-checker.foldersToIgnore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/build/**",
    "**/config/**",
    "**/.**/**",
    "**/*.test.*",
    "**/*.spec.*",
    "eslint.config.mjs",
    "**/worker/**",
    "**/scripts/**",
    "**/docs/**"
  ]
}
