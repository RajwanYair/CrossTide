{
  "name": "crosstide",
  "version": "11.44.0",
  "description": "CrossTide Web — browser-based stock monitoring dashboard with 12-method consensus signals, interactive charting, and offline-first PWA.",
  "keywords": [
    "stock-market",
    "finance",
    "fintech",
    "investing",
    "technical-analysis",
    "technical-indicators",
    "trading",
    "trading-strategies",
    "backtesting",
    "stock-charts",
    "stock-analysis",
    "rsi",
    "macd",
    "bollinger-bands",
    "dashboard",
    "pwa",
    "offline-first",
    "typescript",
    "vite",
    "cloudflare-workers",
    "web-components"
  ],
  "type": "module",
  "private": true,
  "workspaces": [
    "docs-site",
    "mcp-server"
  ],
  "exports": {
    ".": "./src/main.ts",
    "./core": "./src/core/index.ts",
    "./domain": "./src/domain/index.ts",
    "./cards": "./src/cards/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "homepage": "https://github.com/RajwanYair/CrossTide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajwanYair/CrossTide.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "dev:components": "vite docs/components-preview.html",
    "build": "tsc --noEmit && tsc --project tsconfig.sw.json --noEmit && vite build && node scripts/workbox-inject.mjs",
    "build:only": "vite build && node scripts/workbox-inject.mjs",
    "build:sourcemaps": "npm run build && node scripts/upload-sourcemaps.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run --pool=threads",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lhci": "lhci autorun --config config/lighthouserc.json",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:nocache": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --config config/.stylelintrc.json --max-warnings 0",
    "lint:html": "htmlhint index.html --config config/.htmlhintrc",
    "lint:md": "markdownlint-cli2 --config config/.markdownlint.json \"**/*.md\" \"#**/node_modules/**\" \"#dist\" \"#coverage\" \"#build\" \"#test-results\" \"#playwright-report\" \"#docs/INDICATORS.md\" \"#docs/ROADMAP-v6-archive.md\" \"#docs/ROADMAP-v8-archive.md\" \"#docs/ROADMAP-v9-archive.md\"",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html && npm run lint:md && npm run format:check && npm run audit:headers",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.sw.json --noEmit",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:wasm": "node scripts/check-wasm-size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:supply-chain": "npm audit --omit=dev --audit-level=high && npm audit signatures",
    "gen:csp": "node scripts/gen-csp.mjs",
    "gen:api-types": "node --experimental-strip-types scripts/gen-openapi-client.mjs",
    "gen:indicator-docs": "tsx scripts/generate-indicator-docs.ts",
    "audit:jsdoc": "node scripts/audit-jsdoc.mjs",
    "audit:headers": "node scripts/audit-file-headers.mjs",
    "ci": "npm run typecheck && npm run lint:all && npm run test:coverage && npm run build:only && npm run check:bundle",
    "test:mutate": "stryker run --configFile config/stryker.config.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "test:e2e:cards": "playwright test tests/e2e/cards.spec.ts --reporter=line",
    "record:demos": "tsx scripts/record-demos.ts",
    "clean": "node scripts/clean.mjs",
    "setup:machine": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-machine-tools.ps1",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "./node_modules/.bin/commitlint --config config/commitlint.config.mjs --edit $1",
    "pre-commit": "./node_modules/.bin/lint-staged"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "biome format --no-errors-on-unmatched --write"
    ],
    "*.css": [
      "stylelint --config config/.stylelintrc.json --max-warnings 0 --fix",
      "biome format --no-errors-on-unmatched --write"
    ],
    "*.{md,json,html}": [
      "biome format --no-errors-on-unmatched --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.1",
    "htmlhint": "^1.9.2",
    "https-proxy-agent": "^9.1.0",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.62.0",
    "postcss": "^8.5.25",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10",
    "workbox-background-sync": "^7.4.0",
    "workbox-build": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-navigation-preload": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "hono": "^4.12.32",
    "lightweight-charts": "^5.2.0",
    "lit-html": "^3.3.3",
    "morphdom": "^2.7.8",
    "valibot": "^1.3.1"
  },
  "allowScripts": {
    "esbuild": true,
    "simple-git-hooks": true,
    "unrs-resolver": true,
    "workerd": true
  }
}
