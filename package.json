{
  "name": "crosstide",
  "version": "11.44.6",
  "description": "CrossTide Web — browser-based stock monitoring dashboard with 12-method consensus signals, interactive charting, and offline-first PWA.",
  "keywords": [
    "stock-market",
    "finance",
    "fintech",
    "investing",
    "technical-analysis",
    "technical-indicators",
    "trading-strategies",
    "backtesting",
    "stock-charts",
    "stock-analysis",
    "rsi",
    "macd",
    "bollinger-bands",
    "dashboard",
    "pwa",
    "offline-first",
    "typescript",
    "vite",
    "cloudflare-workers",
    "web-components"
  ],
  "type": "module",
  "private": true,
  "workspaces": [
    "docs-site",
    "mcp-server",
    "packages/*"
  ],
  "exports": {
    ".": "./src/main.ts",
    "./core": "./src/core/index.ts",
    "./domain": "./src/domain/index.ts"
  },
  "homepage": "https://github.com/RajwanYair/CrossTide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajwanYair/CrossTide.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "dev:components": "vite docs/components-preview.html",
    "build": "tsc --noEmit && tsc --project tsconfig.sw.json --noEmit && vite build && npm run build:widget && node scripts/workbox-inject.mjs",
    "build:only": "vite build && npm run build:widget && node scripts/workbox-inject.mjs",
    "build:domain": "npm run build --workspace @crosstide/domain",
    "build:widget": "vite build --config vite.widget.config.ts",
    "build:sourcemaps": "npm run build && node scripts/upload-sourcemaps.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run --pool=threads",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lhci": "lhci autorun --config config/lighthouserc.json",
    "lint": "oxlint --type-aware --quiet --tsconfig tsconfig.json src worker tests scripts",
    "lint:nocache": "oxlint --type-aware --quiet --tsconfig tsconfig.json src worker tests scripts",
    "lint:css": "stylelint \"src/**/*.css\" --config config/.stylelintrc.json --max-warnings 0",
    "lint:html": "htmlhint index.html --config config/.htmlhintrc",
    "lint:md": "markdownlint-cli2 --config config/.markdownlint.json \"**/*.md\" \"#**/node_modules/**\" \"#dist\" \"#coverage\" \"#build\" \"#test-results\" \"#playwright-report\" \"#docs/INDICATORS.md\"",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html && npm run lint:md && npm run format:check && npm run audit:headers && npm run check:contrast",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.sw.json --noEmit",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "check:domain-purity": "node scripts/check-domain-purity.mjs",
    "check:fork-config": "node scripts/check-fork-config.mjs",
    "check:reachability": "node scripts/reachability-inventory.mjs --json",
    "check:reachability:report": "node scripts/reachability-inventory.mjs --check-markdown",
    "check:reachability:gate": "node scripts/reachability-inventory.mjs --reachability-gate",
    "check:reachable-coverage": "node scripts/reachability-inventory.mjs --reachable-coverage",
    "check:repo-contracts": "npm run check:doc-facts && npm run check:doc-ownership && npm run check:public-exports && npm run check:roadmap-priorities && npm run check:md-links && npm run check:reachability:report && npm run check:reachability:gate && npm run check:wasm && npm run check:workflow-policy && npm run check:fork-config && npm run check:domain-purity && npm run check:performance-budgets && node scripts/arch-check.mjs --strict",
    "check:doc-facts": "node scripts/check-doc-facts.mjs",
    "check:doc-ownership": "node scripts/check-doc-ownership.mjs",
    "check:public-exports": "node scripts/check-public-exports.mjs",
    "check:roadmap-priorities": "node scripts/check-roadmap-priorities.mjs",
    "check:md-links": "node scripts/check-markdown-links.mjs",
    "check:wasm": "node scripts/check-wasm-size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:performance-budgets": "node --experimental-strip-types scripts/check-performance-budgets.mjs",
    "check:workflow-policy": "node scripts/check-workflow-policy.mjs",
    "check:supply-chain": "npm run audit:dependencies && npm audit signatures",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "gen:csp": "node scripts/gen-csp.mjs",
    "gen:api-types": "node --experimental-strip-types scripts/gen-openapi-client.mjs",
    "check:api-types": "npm run gen:api-types && git diff --exit-code -- src/core/api-types.ts",
    "gen:indicator-docs": "tsx scripts/generate-indicator-docs.ts",
    "audit:jsdoc": "node scripts/audit-jsdoc.mjs",
    "audit:headers": "node scripts/audit-file-headers.mjs",
    "ci": "npm run typecheck && npm run lint:all && npm run check:repo-contracts && npm run check:api-types && npm run test:coverage && npm run check:reachable-coverage && npm run build:only && npm run check:bundle && npm run check:bundle-secrets && npm run check:supply-chain",
    "test:mutate": "stryker run --configFile config/stryker.config.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "test:e2e:cards": "playwright test tests/e2e/cards.spec.ts --reporter=line",
    "test:e2e:performance": "playwright test tests/e2e/performance.spec.ts --project=chromium --reporter=line",
    "test:e2e:performance:profiles": "playwright test tests/e2e/performance.spec.ts --workers=1 --project=chromium --project=mobile-chrome-landscape --project=android-galaxy --reporter=line",
    "record:demos": "tsx scripts/record-demos.ts",
    "clean": "node scripts/clean.mjs",
    "setup:machine": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-machine-tools.ps1",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "./node_modules/.bin/commitlint --config config/commitlint.config.mjs --edit $1",
    "pre-commit": "./node_modules/.bin/lint-staged"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "oxlint --type-aware --quiet --tsconfig tsconfig.json --fix",
      "biome format --no-errors-on-unmatched --write"
    ],
    "*.css": [
      "stylelint --config config/.stylelintrc.json --max-warnings 0 --fix",
      "biome format --no-errors-on-unmatched --write"
    ],
    "*.{md,json,html}": [
      "biome format --no-errors-on-unmatched --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "assemblyscript": "^0.28.20",
    "astro": "^7.1.5",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.1",
    "htmlhint": "^1.9.2",
    "https-proxy-agent": "^9.1.0",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.0",
    "postcss": "8.5.25",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "typescript": "7.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.10",
    "workbox-background-sync": "^7.4.0",
    "workbox-build": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-navigation-preload": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "hono": "^4.12.32",
    "lightweight-charts": "^5.2.0",
    "lit-html": "^3.3.3",
    "morphdom": "^2.7.8",
    "valibot": "^1.3.1"
  },
  "allowScripts": {
    "esbuild": true,
    "simple-git-hooks": true,
    "unrs-resolver": true,
    "workerd": true
  },
  "overrides": {
    "typescript": "7.0.2"
  }
}
